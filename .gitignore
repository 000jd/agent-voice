# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments — the core venv and every per-engine venv.
# These are multi-GB and fully reproducible from pyproject.toml + uv.lock.
.venv/
engines/*/.venv/
engines/*/variants/*/.venv/
# Which dependency variant is installed into the canonical engine venv.
engines/*/.variant

# Runtime data: voices, cache, artifacts, jobs, bindings, logs
data/

# Runtime lock files (filelock: bindings.json.lock, daemon.lock, .registry.lock)
*.lock
# ...but dependency lock files MUST be committed for reproducible installs.
!uv.lock
!engines/*/uv.lock
!frontend/bun.lock

# Frontend (Node/Bun lives only inside frontend/)
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# Local configuration (copy .env.example)
.env

# Test / tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / agent-local state (not part of the project source)
.commandcode/
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db

# Manim demo output
examples/manim_demo/media/
examples/manim_demo/out/
examples/manim_demo/timings.json
