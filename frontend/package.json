{
	"name": "agent-voice-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.5",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:svelte5": "node scripts/check-svelte5.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"gen:api": "cd .. && uv run python scripts/export_openapi.py --output frontend/openapi.json && cd frontend && bunx openapi-typescript openapi.json -o src/lib/api/schema.d.ts --alphabetize",
		"check:api": "cd .. && uv run python scripts/export_openapi.py --output frontend/openapi.json --check && cd frontend && bunx openapi-typescript openapi.json -o src/lib/api/schema.d.ts --alphabetize --check"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "0.561.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "24.19.2",
		"bits-ui": "2.21.0",
		"cn": "0.5.2",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"happy-dom": "21.0.4",
		"openapi-fetch": "0.17.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
