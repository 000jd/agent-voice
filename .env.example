# agent-voice configuration. Copy to .env and adjust.

# --- Server ---------------------------------------------------------------
AGENT_VOICE_HOST=127.0.0.1
AGENT_VOICE_PORT=8000

# Optional bearer token. When set, every /v1/*, /mcp/* and /audio/* request must
# send `Authorization: Bearer <key>`. /health stays open.
AGENT_VOICE_API_KEY=

# Extra Host header values the DNS-rebinding guard will accept, beyond the
# loopback defaults (127.0.0.1, localhost, [::1]). Leave as `[]` for loopback
# only; add an entry such as ["devbox.lan:8000"] if you deliberately front the
# daemon with a different hostname.
AGENT_VOICE_ALLOWED_HOSTS=[]

# Agent-supplied media paths (clone_voice ref_audio_path, transcribe audio_path,
# dub_prepare media_path). false (the safe default) confines them to
# <DATA_DIR>/inbox/; set true only when a trusted local agent must read any
# existing local file. The CLI `voices add` remains unrestricted either way.
AGENT_VOICE_ALLOW_ANY_PATH=false

# --- Defaults -------------------------------------------------------------
# mock | qwen3_tts | qwen3_tts_fast
#
# qwen3_tts_fast is the default because it was verified on this reference box
# (RTX 4060 Ti / driver 580 / torch 2.11.0+cu128): CUDA graphs capture and native
# PCM streaming works. If graph capture fails on your hardware, switch to
# qwen3_tts (official, reliable, streaming emulated).
AGENT_VOICE_DEFAULT_ENGINE=qwen3_tts_fast
AGENT_VOICE_DEFAULT_VOICE_ID=

# Which kind:asr engine a transcription uses when a request names none.
#   phonon      - real ASR, CPU only, 0 MB VRAM, 25 languages, 156 MB per model
#   mock_asr    - dependency-free synthetic transcript, for plumbing tests
# Deliberately separate from AGENT_VOICE_DEFAULT_ENGINE: speech in and speech out
# are different plugin families, and a CPU listener next to a GPU speaker is the
# normal deployment. If the engine is not installed, doctor WARNS (never fails)
# and transcribe answers ENGINE_NOT_INSTALLED.
AGENT_VOICE_DEFAULT_ASR_ENGINE=phonon

# --- Hardware -------------------------------------------------------------
# Which runtime device each engine runs on. A device is a DEPENDENCY SET, not a
# runtime flag: CPU and CUDA lock different torch builds, so changing this
# reinstalls that engine's venv with
#   agent-voice engines install <engine_id> --device <device>
#
#   auto  resolve per engine: AGENT_VOICE_DEVICES -> this value -> the manifest's
#         default_device -> the host's accelerator (cuda / mps / rocm / cpu).
#         auto never picks an `experimental` pair when a verified one exists, and
#         it never silently downgrades: a device this host cannot serve is an
#         error telling you to pin AGENT_VOICE_DEVICE/AGENT_VOICE_DEVICES.
#   cpu   verified for kokoro, phonon, mock, mock_asr and qwen3_tts; the only
#         device where the "0 MB VRAM" claim holds (kokoro/phonon)
#   cuda  NVIDIA; verified for qwen3_tts and qwen3_tts_fast on the reference box
#   mps   Apple silicon; experimental (MLX for phonon)
#   rocm  AMD on Linux; experimental - a lock exists, no AMD GPU was available
#
# Supported pairs are DEVICE_SUPPORT in src/agent_voice/hardware.py; the honest
# per-(engine, device) matrix is in README.md and docs/engines.md. Unsupported
# pairs are refused even with --experimental: qwen3_tts_fast is CUDA-only, and
# phonon's NVIDIA path is a container, not a wheel.
AGENT_VOICE_DEVICE=auto

# Per-engine overrides, one comma-separated spelling. Takes precedence over
# AGENT_VOICE_DEVICE. Unknown engine ids and undeclared devices fail at startup
# and in `agent-voice doctor` with the supported list in the message.
# AGENT_VOICE_DEVICES=kokoro=cpu,qwen3_tts=cuda

# --- GPU lifecycle --------------------------------------------------------
MODEL_IDLE_TTL_SECONDS=900
MAX_ACTIVE_ENGINES=1
MAX_RESIDENT_MODELS=1
MAX_GPU_VRAM_GB=12.5
MIN_ENGINE_RESIDENCY_SECONDS=60
MIN_FREE_VRAM_GB=2.0
ENABLE_VRAM_PRESSURE_YIELD=true

# Uncached GPU jobs wait in a FIFO queue per engine. When that queue is full the
# request is refused with 429 BACKPRESSURE instead of piling up, so retry later
# or submit long work with start_script_job. Cache hits and read-only calls never
# enter this queue — they are answered before an engine slot is requested.
MAX_QUEUE_DEPTH=64

# --- Cache / audio --------------------------------------------------------
MAX_CACHE_GB=5.0
CHUNK_CHARS=400
MAX_TEXT_CHARS=20000
NORMALIZE_LUFS=-16

# Input caps, enforced at admission — before routing, before a worker is spawned
# and before any GPU time is spent. Oversized text is 413 TEXT_TOO_LONG; an
# over-long beat list is BAD_REQUEST. Raise them deliberately, not to silence an
# error: the point is that a runaway request costs a round-trip and nothing else.
#
#   MAX_SCRIPT_BEATS         beats in one speak_script / /v1/scripts call
#   MAX_INSTRUCT_CHARS       instruct on speak, a beat, or in a voice design
#   MAX_DESIGN_SAMPLE_CHARS  design_voice(sample_text=...)
#   MAX_REF_TEXT_CHARS       clone_voice(ref_text=...)
MAX_SCRIPT_BEATS=200
MAX_INSTRUCT_CHARS=1000
MAX_DESIGN_SAMPLE_CHARS=500
MAX_REF_TEXT_CHARS=2000

# Speech-in caps. MAX_TRANSCRIBE_SECONDS bounds *work*, not file size: the
# ffprobe duration is checked before any ffmpeg extraction or worker, so an
# oversized upload costs one probe and nothing else. An hour is a generous
# podcast. MAX_DUB_SEGMENTS bounds one dub_render and is checked before the
# first line is synthesised, so a runaway render is refused in milliseconds.
# Violations are 400 BAD_REQUEST naming the cap.
MAX_TRANSCRIBE_SECONDS=3600
MAX_DUB_SEGMENTS=500

# --- Streaming ------------------------------------------------------------
STREAM_QUEUE_MAXSIZE=32
STREAM_QUEUE_TIMEOUT_SECONDS=5.0

# --- Agent tooling --------------------------------------------------------
# OFF BY DEFAULT, and it should stay off unless you specifically want it.
#
# Turning this on lets an AI agent write new engine code — engine.yaml,
# worker.py, pyproject.toml — into engines/ AND execute it: worker.py is run as
# a Python script on this machine. That is arbitrary code execution requested by
# a language model. Enable it only when you are deliberately having an agent
# author and run an engine, on a machine where that is acceptable.
#
# Even when enabled, mutation is loopback-only.
ALLOW_AGENT_ENGINE_MUTATION=false

# When true, register_engine stages the plugin under engines/.pending/<id>/
# instead of activating it. An operator promotes it with `agent-voice engines
# approve <id>`, which prints the model list and the worker.py hash and asks for
# confirmation. This turns "an agent wrote code" into "an agent wrote code and a
# human read it". Default ON here AND in code, so a fresh checkout is gated even
# if this file is never copied. It only has an effect when
# ALLOW_AGENT_ENGINE_MUTATION is also enabled, and then a human gate is exactly
# what you want.
REQUIRE_ENGINE_APPROVAL=true

# Which MCP tools to expose.
#   auto  - read/synthesis surface normally, full surface when mutation is on
#   core  - speak / speak_script / voice clone+list+delete / GPU status
#   full  - everything, including register_engine / register_model / install_engine
# `core` is the safest choice for an agent that only needs to make audio.
AGENT_VOICE_TOOLSET=auto

# Confines local media reads (ref_audio_path, and transcription's audio_path /
# media_path) AND relocates output artifacts so the returned file_path stays
# readable inside an agent sandbox. Takes precedence over AGENT_VOICE_ALLOW_ANY_PATH.
# A relative value resolves against AGENT_VOICE_HOME, not the current directory.
# Prefixed alias, accepted too (and wins if both are set): AGENT_VOICE_MCP_BASE_PATH
MCP_BASE_PATH=

# --- Paths ----------------------------------------------------------------
# The one anchor. `agent-voice` reads <AGENT_VOICE_HOME>/.env (this file), and a
# relative DATA_DIR/ENGINES_DIR resolves against it - not against the current
# directory - so the CLI and daemon work from anywhere. Unset means: the checkout
# holding both pyproject.toml and engines/, else ~/.agent-voice (doctor reports it).
# A systemd unit's WorkingDirectory= no longer decides which .env is read.
# AGENT_VOICE_HOME=/home/you/agent-voice

# Relative values are fine and resolve to <home>/data and <home>/engines. Prefer
# absolute paths when the data lives on another disk; `agent-voice setup` writes
# absolute ones. Prefixed aliases, accepted too and winning if both are set:
#   AGENT_VOICE_DATA_DIR / AGENT_VOICE_ENGINES_DIR
# DATA_DIR=./data
# ENGINES_DIR=./engines
